# Pick ONE way to reach an open-weight model.

# Option A: Groq (free key, hosts open-weight models like Llama 3.3)
#   Get a key at https://console.groq.com/keys
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_your_key_here
# HF_MODEL=llama-3.3-70b-versatile

# Option B: Hugging Face Inference Providers (free tier has small monthly credits)
# Token from https://huggingface.co/settings/tokens
# (create a "fine-grained" token with "Make calls to Inference Providers" enabled)
HF_TOKEN=

# Any open-weight chat model served by Hugging Face Inference Providers
HF_MODEL=Qwen/Qwen2.5-72B-Instruct

# Option C: run an open-weight model on your own server instead.
# Any OpenAI-compatible server works. Set HF_MODEL to the name that server uses, e.g.:
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1   HF_MODEL=qwen2.5:7b
#   llama.cpp:  LLM_BASE_URL=http://localhost:8080/v1    HF_MODEL=qwen2.5-7b-instruct
#   vLLM:       LLM_BASE_URL=http://localhost:8000/v1    HF_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_BASE_URL=
